datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
  RECEPTIONIST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum FeeStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  NET_BANKING
  CARD
  CHEQUE
  RAZORPAY
}

model SchoolBranch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String
  phone       String
  email       String
  affiliation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  students    Student[]
  staff       Staff[]
  classes     ClassRoom[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(STUDENT)
  avatarUrl    String?
  phone        String?
  branchId     String?
  branch       SchoolBranch? @relation(fields: [branchId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student      Student?
  staff        Staff?
  auditLogs    AuditLog[]
}

model Student {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  admissionNo    String        @unique
  rollNo         String
  firstName      String
  lastName       String
  gender         String
  dob            DateTime
  bloodGroup     String?
  guardianName   String
  guardianPhone  String
  guardianEmail  String?
  address        String
  branchId       String
  branch         SchoolBranch  @relation(fields: [branchId], references: [id])
  classId        String
  classRoom      ClassRoom     @relation(fields: [classId], references: [id])
  sectionId      String
  section        Section       @relation(fields: [sectionId], references: [id])
  admissionDate  DateTime      @default(now())
  isActive       Boolean       @default(true)

  attendance     Attendance[]
  marks          MarksRecord[]
  feeInvoices    FeeInvoice[]
}

model Staff {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id])
  employeeCode   String        @unique
  firstName      String
  lastName       String
  department     String
  designation    String
  qualification  String
  experienceYrs  Int           @default(0)
  joiningDate    DateTime      @default(now())
  salary         Float         @default(0)
  branchId       String
  branch         SchoolBranch  @relation(fields: [branchId], references: [id])

  timetables     TimetablePeriod[]
}

model ClassRoom {
  id        String       @id @default(cuid())
  name      String       // e.g. "Grade 10"
  numeric   Int          // 10
  branchId  String
  branch    SchoolBranch @relation(fields: [branchId], references: [id])

  sections  Section[]
  students  Student[]
}

model Section {
  id          String       @id @default(cuid())
  name        String       // "A", "B", "C"
  classId     String
  classRoom   ClassRoom    @relation(fields: [classId], references: [id])
  students    Student[]
  timetables  TimetablePeriod[]
}

model Subject {
  id          String       @id @default(cuid())
  name        String       // "Mathematics"
  code        String       // "MATH101"
  timetables  TimetablePeriod[]
  marks       MarksRecord[]
}

model TimetablePeriod {
  id        String    @id @default(cuid())
  dayOfWeek String    // "MONDAY", "TUESDAY", etc.
  startTime String    // "08:30"
  endTime   String    // "09:15"
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Staff     @relation(fields: [teacherId], references: [id])
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  recordedAt  DateTime         @default(now())

  @@unique([studentId, date])
}

model FeeInvoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id])
  totalAmount Float
  paidAmount  Float         @default(0)
  dueAmount   Float
  status      FeeStatus     @default(UNPAID)
  dueDate     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments    FeePayment[]
}

model FeePayment {
  id          String        @id @default(cuid())
  receiptNo   String        @unique
  invoiceId   String
  invoice     FeeInvoice    @relation(fields: [invoiceId], references: [id])
  amount      Float
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(UPI)
  transactionRef String?
}

model Exam {
  id          String        @id @default(cuid())
  title       String        // "Mid-Term Examination 2026"
  academicYr  String        // "2026-2027"
  startDate   DateTime
  endDate     DateTime
  marks       MarksRecord[]
}

model MarksRecord {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  maxMarks    Float    @default(100)
  obtainedMarks Float
  grade       String   // "A+", "A", "B", etc.
  remarks     String?
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   // "ACADEMIC", "EXAM", "EVENT", "URGENT"
  priority    String   @default("NORMAL")
  publishedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
}
